# Copy to deploy/athanor.env on the server. scripts/public-up.sh sources it,
# and every vault-node inherits the ATHANOR_* values. Keep it out of git.

# The origin visitors use. Every node gossips it, so the dashboard's
# failover stays on this origin.
PUBLIC_URL=https://www.athanor.cfd

# Writes and admin actions (stop, start, corrupt, partition, policy) need
# this bearer token once it is set. Leave empty to run the public demo open.
#   openssl rand -hex 16
ATHANOR_ADMIN_TOKEN=

# Encrypts gossip and authenticates peer RPC. Every node on the cluster
# must share it. Leave empty for a single-machine demo.
#   openssl rand -hex 16
ATHANOR_CLUSTER_SECRET=

# Where cloudflared finds its tunnel token (default ~/.cloudflared/athanor.token).
# TUNNEL_TOKEN_FILE=/home/ubuntu/.cloudflared/athanor.token

# Gateway port on the host (cloudflared points at it). Default 8080.
# GATEWAY_PORT=8080

# Scrub and reap intervals, if you want them different from the defaults.
# SCRUB=30s
# REAP=2m
